{
	"name": "@iam2r/pi-upstream-compat",
	"version": "0.4.0",
	"private": false,
	"description": "Pi extension: upstream compatibility shims for models served through third-party gateways — OpenCode session headers and thinking-mode reasoning_content replay, both decided by model id",
	"keywords": [
		"extension",
		"gateway",
		"headers",
		"opencode",
		"pi",
		"pi-coding-agent",
		"pi-package",
		"reasoning",
		"session",
		"thinking"
	],
	"homepage": "https://github.com/iam2r/pkgs/tree/main/packages/pi-upstream-compat#readme",
	"bugs": {
		"url": "https://github.com/iam2r/pkgs/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iam2r/pkgs.git",
		"directory": "packages/pi-upstream-compat"
	},
	"files": [
		"src",
		"!src/__tests__",
		"README.md",
		"CHANGELOG.md"
	],
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"require": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc",
		"test": "vitest run"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-ai": {
			"optional": true
		},
		"@earendil-works/pi-coding-agent": {
			"optional": true
		}
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	}
}
