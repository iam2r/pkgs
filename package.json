{
	"name": "pkgs",
	"version": "0.0.1",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build:pkg": "turbo run build --filter='./packages/*'",
		"clean:pkg": "node scripts/clean-pkg.mjs",
		"changeset": "changeset",
		"release:add": "node scripts/release-add.mjs",
		"release:version": "pnpm changeset version",
		"release:tag": "pnpm changeset tag",
		"release:publish": "pnpm publish -r --access public",
		"release:full": "pnpm run build:pkg && pnpm release:tag && pnpm release:publish",
		"test": "turbo run test --filter='./packages/*'",
		"preinstall": "npx only-allow pnpm",
		"prepare": "husky",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint --type-aware --fix",
		"lint:count": "node scripts/oxlint-severity-count.mjs --unfiltered"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@earendil-works/pi-ai": "^1.3.0",
		"@earendil-works/pi-coding-agent": "^1.3.0",
		"@types/node": "^24.10.13",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@typescript/typescript6": "npm:@typescript/typescript6@^6.0.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"oxfmt": "^0.73.0",
		"oxlint": "^1.88.0",
		"oxlint-tsgolint": "^7.0.2004",
		"turbo": "^2.11.8",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	},
	"lint-staged": {
		"*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue}": "node scripts/lint-staged-oxlint.mjs",
		"*": "oxfmt --no-error-on-unmatched-pattern"
	},
	"engines": {
		"node": ">=24",
		"pnpm": ">=10"
	},
	"engineStrict": true,
	"packageManager": "pnpm@12.11.2"
}
